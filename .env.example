# Django Backend Configuration
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-unique-random-secret-key
DJANGO_ALLOWED_HOSTS=api-test.movr.app,api.movr.app
MOVR_ENV=render-test
API_PORT=8000

# Database Configuration
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_NAME=movr_db
DB_PORT=5432
# Render/Supabase: use the Session Pooler URL and require SSL.
DATABASE_URL=postgresql://postgres.project-ref:change-this-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_STORAGE_AVATAR_PREFIX=profile-avatars
SUPABASE_STORAGE_AVATAR_PUBLIC=true
SUPABASE_VEHICLE_BUCKET=vehicle-documents
SUPABASE_STORAGE_VEHICLE_PREFIX=vehicle-documents
SUPABASE_STORAGE_VEHICLE_PUBLIC=false
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Frontend and Security
MOVR_FRONTEND_BASE_URL=https://app.movr.app
MOVR_PASSWORD_RESET_DEEP_LINK_BASE=movr://reset-password
MOVR_EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
CORS_ALLOWED_ORIGINS=https://test.movr.app,https://app.movr.app
CSRF_TRUSTED_ORIGINS=https://test.movr.app,https://app.movr.app
# Upstash/Render: use the TLS Redis URL, not the REST URL.
REDIS_URL=rediss://default:change-this-password@upstash-endpoint:6379

# Resend email delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Movr <no-reply@yourdomain.com>

# Monnify wallet funding
MONNIFY_API_KEY=mk_test_your_api_key
MONNIFY_SECRET_KEY=msk_test_your_secret_key
MONNIFY_CONTRACT_CODE=your_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Google APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Flutter build-time environment
MOVR_API_BASE_URL=https://api-test.movr.app
MOVR_WS_BASE_URL=wss://api-test.movr.app
MOVR_ENVIRONMENT=test
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
